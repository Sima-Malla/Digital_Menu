generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id                BigInt     @id @default(autoincrement())
  businessName      String
  businessType      String?
  businessAddress   String?
  businessPhone     String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  allowReviews      Boolean    @default(true)
  bannerUrl         String?
  currency          String     @default("USD ($)")
  email             String?    @unique
  facebook          String?
  instagram         String?
  language          String     @default("English (US)")
  listInMarketplace Boolean    @default(true)
  logoUrl           String?
  showOnMap         Boolean    @default(true)
  taxId             String?
  taxRegistration   String?
  timezone          String     @default("EST (UTC-5)")
  twitter           String?
  website           String?
  ownerName         String?               // <-- NAYA
  plan              String     @default("Basic")     // <-- NAYA
  status            String     @default("Pending")   // <-- NAYA
  Area              Area[]
  locations         Location[]
  menuItems         MenuItem[]
  orders            Order[]
  specials          Special[]
  staff             Staff[]
}

model Staff {
  id              BigInt   @id @default(autoincrement())
  businessId      BigInt
  fullName        String
  email           String   @unique
  password        String
  role            String   @default("staff")
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isActive        Boolean  @default(true)
  position        String   @default("Waiter")
  needsOnboarding Boolean  @default(true)
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model SuperAdmin {
  id        BigInt   @id @default(autoincrement())
  fullName  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model MenuItem {
  id          BigInt      @id @default(autoincrement())
  businessId  BigInt
  name        String
  description String?
  category    String
  price       Decimal     @db.Decimal(10, 2)
  calories    Int?
  imageUrl    String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  specials    Special[]

  @@index([businessId])
}

model Special {
  id           BigInt    @id @default(autoincrement())
  businessId   BigInt
  menuItemId   BigInt
  badgeLabel   String
  scheduleType String
  weekday      Int?
  date         DateTime?
  imageUrl     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menuItem     MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([menuItemId])
}

model Customer {
  id        BigInt   @id @default(autoincrement())
  name      String
  phone     String   @unique
  email     String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Location {
  id         BigInt   @id @default(autoincrement())
  businessId BigInt
  label      String
  type       String   @default("dine-in")
  status     String   @default("active")
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([businessId, label])
  @@index([businessId])
}

model Order {
  id            BigInt      @id @default(autoincrement())
  businessId    BigInt
  customerId    BigInt
  locationId    BigInt?
  orderType     String
  status        String      @default("new")
  delayReason   String?
  paymentStatus String      @default("unpaid")
  totalAmount   Decimal     @db.Decimal(10, 2)
  orderedAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  escalated     Boolean     @default(false)
  notifiedAt    DateTime?
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer    @relation(fields: [customerId], references: [id])
  location      Location?   @relation(fields: [locationId], references: [id])
  items         OrderItem[]

  @@index([businessId])
  @@index([status])
}

model OrderItem {
  id         BigInt   @id @default(autoincrement())
  orderId    BigInt
  menuItemId BigInt
  name       String
  unitPrice  Decimal  @db.Decimal(10, 2)
  quantity   Int
  notes      String?
  createdAt  DateTime @default(now())
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model PlatformUser {
  id           BigInt                 @id @default(autoincrement())
  fullName     String
  email        String                 @unique
  phone        String?
  role         String                 @default("Viewer")
  department   String?
  status       String                 @default("Active")
  permissions  String[]               @default([])
  lastActiveAt DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  activities   PlatformUserActivity[]
}

model PlatformUserActivity {
  id        BigInt       @id @default(autoincrement())
  userId    BigInt
  label     String
  createdAt DateTime     @default(now())
  user      PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SystemLog {
  id              BigInt   @id @default(autoincrement())
  event           String
  module          String
  level           String   @default("Info")
  status          String
  userName        String?
  userInitials    String?
  business        String?
  ipAddress       String?
  details         String?
  isSecurityEvent Boolean  @default(false)
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([level])
  @@index([module])
  @@index([createdAt])
  @@index([archived])
}

model BusinessRule {
  id                       BigInt             @id @default(autoincrement())
  autoApproveBusinesses    Boolean            @default(false)
  requireVerification      Boolean            @default(true)
  defaultBusinessStatus    String             @default("Pending")
  payoutFrequency          String             @default("Weekly")
  payoutThreshold          Decimal            @default(1000) @db.Decimal(10, 2)
  payoutMethod             String             @default("Bank Transfer")
  minOrderValue            Decimal            @default(150) @db.Decimal(10, 2)
  allowPerBusinessOverride Boolean            @default(true)
  updatedAt                DateTime           @updatedAt
  tiers                    CommissionTier[]
  documents                RequiredDocument[]
}

model RequiredDocument {
  id        BigInt       @id @default(autoincrement())
  ruleId    BigInt
  name      String
  required  Boolean      @default(false)
  sortOrder Int          @default(0)
  rule      BusinessRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

model CommissionTier {
  id         BigInt       @id @default(autoincrement())
  ruleId     BigInt
  name       String
  commission Decimal      @db.Decimal(5, 2)
  sortOrder  Int          @default(0)
  rule       BusinessRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

model Area {
  id            BigInt    @id @default(autoincrement())
  businessId    BigInt
  type          String
  name          String
  status        String    @default("available")
  capacity      Int
  unitCount     Int
  style         String
  note          String?
  occupancyRate Int       @default(0)
  revenueToday  Decimal   @default(0) @db.Decimal(10, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  SubUnit       SubUnit[]

  @@index([businessId])
}

model SubUnit {
  id            BigInt    @id @default(autoincrement())
  areaId        BigInt
  label         String
  status        String    @default("available")
  guestName     String?
  orderItems    String[]  @default([])
  orderPlacedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Area          Area      @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([areaId])
}
