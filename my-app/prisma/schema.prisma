generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id                BigInt   @id @default(autoincrement())
  businessName      String
  businessType      String?
  businessAddress   String?
  businessPhone     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  allowReviews      Boolean  @default(true)
  bannerUrl         String?
  currency          String   @default("USD ($)")
  email             String?  @unique
  facebook          String?
  instagram         String?
  language          String   @default("English (US)")
  listInMarketplace Boolean  @default(true)
  logoUrl           String?
  showOnMap         Boolean  @default(true)
  taxId             String?
  taxRegistration   String?
  timezone          String   @default("EST (UTC-5)")
  twitter           String?
  website           String?
  ownerName         String?
  plan              String   @default("Basic")
  status            String   @default("Pending")

  lastPaymentFailedAt DateTime?
  lastPaymentAt       DateTime?
  Area                Area[]
  locations           Location[]
  menuItems           MenuItem[]
  orders              Order[]
  specials            Special[]
  staff               Staff[]
  paymentGateways     PaymentGateway[]
  paymentMethods      PaymentMethod[]
  paymentSettings     PaymentSettings?
  reviews             BusinessReview[]


  businessHours BusinessHours[]
  specialHours  SpecialHours[]
  notificationPreference BusinessNotificationPreference?
  notifications          BusinessNotification[]
}

model BusinessHours {
  id         BigInt   @id @default(autoincrement())
  businessId BigInt
  dayOfWeek  Int      // 0=Sunday..6=Saturday — matches JS Date.getDay()
  isOpen     Boolean  @default(true)
  openTime   String?  // display string, e.g. "09:00 AM" — matches how the UI already treats hours
  closeTime  String?
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model SpecialHours {
  id         BigInt   @id @default(autoincrement())
  businessId BigInt
  name       String
  date       String   // display string, e.g. "Dec 24, 2024"
  status     String   // "LIMITED" | "CLOSED" | "EXTENDED"
  hours      String?  // e.g. "09:00 - 15:00", or "--" when CLOSED
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Staff {
  id              BigInt   @id @default(autoincrement())
  businessId      BigInt
  fullName        String
  email           String   @unique
  password        String
  role            String   @default("staff")
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isActive        Boolean  @default(true)
  position        String   @default("Waiter")
  needsOnboarding Boolean  @default(true)
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model SuperAdmin {
  id        BigInt   @id @default(autoincrement())
  fullName  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model MenuItem {
  id          BigInt      @id @default(autoincrement())
  businessId  BigInt
  name        String
  description String?
  category    String
  price       Decimal     @db.Decimal(10, 2)
  calories    Int?
  imageUrl    String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  specials    Special[]

  @@index([businessId])
}

model Special {
  id           BigInt    @id @default(autoincrement())
  businessId   BigInt
  menuItemId   BigInt
  badgeLabel   String
  scheduleType String
  weekday      Int?
  date         DateTime?
  imageUrl     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menuItem     MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([menuItemId])
}

model Customer {
  id        BigInt   @id @default(autoincrement())
  name      String
  phone     String   @unique
  email     String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Location {
  id         BigInt   @id @default(autoincrement())
  businessId BigInt
  label      String
  type       String   @default("dine-in")
  status     String   @default("active")
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([businessId, label])
  @@index([businessId])
}

model Order {
  id            BigInt      @id @default(autoincrement())
  businessId    BigInt
  customerId    BigInt
  locationId    BigInt?
  orderType     String
  status        String      @default("new")
  delayReason   String?
  paymentStatus String      @default("unpaid")
  paymentRef    String?     // gateway transaction reference (eSewa transaction_uuid / FonePay PRN)
  totalAmount   Decimal     @db.Decimal(10, 2)
  orderedAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  escalated     Boolean     @default(false)
  notifiedAt    DateTime?
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer    @relation(fields: [customerId], references: [id])
  location      Location?   @relation(fields: [locationId], references: [id])
  items         OrderItem[]

  @@index([businessId])
  @@index([status])
  @@index([paymentRef])
}
model OrderItem {
  id         BigInt   @id @default(autoincrement())
  orderId    BigInt
  menuItemId BigInt
  name       String
  unitPrice  Decimal  @db.Decimal(10, 2)
  quantity   Int
  notes      String?
  createdAt  DateTime @default(now())
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model PlatformUser {
  id           BigInt                 @id @default(autoincrement())
  fullName     String
  email        String                 @unique
  phone        String?
  role         String                 @default("Viewer")
  department   String?
  status       String                 @default("Active")
  permissions  String[]               @default([])
  lastActiveAt DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  activities   PlatformUserActivity[]

  roleId       BigInt?
  assignedRole Role?                  @relation(fields: [roleId], references: [id])
}

model PlatformUserActivity {
  id        BigInt       @id @default(autoincrement())
  userId    BigInt
  label     String
  createdAt DateTime     @default(now())
  user      PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SystemLog {
  id              BigInt   @id @default(autoincrement())
  event           String
  module          String
  level           String   @default("Info")
  status          String
  userName        String?
  userInitials    String?
  business        String?
  ipAddress       String?
  details         String?
  isSecurityEvent Boolean  @default(false)
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([level])
  @@index([module])
  @@index([createdAt])
  @@index([archived])
}

model BusinessRule {
  id                       BigInt             @id @default(autoincrement())
  autoApproveBusinesses    Boolean            @default(false)
  requireVerification      Boolean            @default(true)
  defaultBusinessStatus    String             @default("Pending")
  payoutFrequency          String             @default("Weekly")
  payoutThreshold          Decimal            @default(1000) @db.Decimal(10, 2)
  payoutMethod             String             @default("Bank Transfer")
  minOrderValue            Decimal            @default(150) @db.Decimal(10, 2)
  allowPerBusinessOverride Boolean            @default(true)
  updatedAt                DateTime           @updatedAt
  tiers                    CommissionTier[]
  documents                RequiredDocument[]
}

model RequiredDocument {
  id        BigInt       @id @default(autoincrement())
  ruleId    BigInt
  name      String
  required  Boolean      @default(false)
  sortOrder Int          @default(0)
  rule      BusinessRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

model CommissionTier {
  id         BigInt       @id @default(autoincrement())
  ruleId     BigInt
  name       String
  commission Decimal      @db.Decimal(5, 2)
  sortOrder  Int          @default(0)
  rule       BusinessRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

model Area {
  id            BigInt    @id @default(autoincrement())
  businessId    BigInt
  type          String
  name          String
  status        String    @default("available")
  capacity      Int
  unitCount     Int
  style         String
  note          String?
  occupancyRate Int       @default(0)
  revenueToday  Decimal   @default(0) @db.Decimal(10, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  SubUnit       SubUnit[]

  @@index([businessId])
}

model SubUnit {
  id            BigInt    @id @default(autoincrement())
  areaId        BigInt
  label         String
  status        String    @default("available")
  guestName     String?
  orderItems    String[]  @default([])
  orderPlacedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Area          Area      @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([areaId])
}

model PlatformSettings {
  id Int @id @default(1) // singleton row, always id = 1

  // Branding
  platformName String @default("Bistro Central")
  brandColor   String @default("#F97316")

  // Regional
  defaultCurrency String @default("NPR")
  timezone        String @default("Asia/Kathmandu")

  // Legal
  termsUrl   String?
  privacyUrl String?

  // Platform rules
  defaultCommissionPct Decimal @default(12) @db.Decimal(5, 2)
  minOrderValue        Decimal @default(200) @db.Decimal(10, 2)

  onlineOrdering  Boolean @default(true)
  guestOrders     Boolean @default(true)
  customerReviews Boolean @default(true)
  maintenanceMode Boolean @default(false)

  updatedAt DateTime @updatedAt

  regions PlatformRegion[]
}

model PlatformRegion {
  id         BigInt   @id @default(autoincrement())
  settingsId Int      @default(1)
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  settings PlatformSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, name])
  @@index([settingsId])
}

model PaymentGateway {
  id           BigInt   @id @default(autoincrement())
  businessId   BigInt
  gatewayKey   String // "esewa" | "khalti" | "stripe"
  name         String
  enabled      Boolean  @default(false)
  apiKeyEnc    String?
  secretKeyEnc String?
  lastTestOk   Boolean?
  updatedAt    DateTime @updatedAt
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, gatewayKey])
}

model PaymentMethod {
  id         BigInt   @id @default(autoincrement())
  businessId BigInt
  methodKey  String // "cod" | "wallet" | "card" | "bank"
  name       String
  enabled    Boolean  @default(false)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, methodKey])
}

model PaymentSettings {
  businessId       BigInt   @id
  transactionFee   Decimal  @default(2.5) @db.Decimal(5, 2)
  feeBearer        String   @default("Business")
  autoRefund       Boolean  @default(true)
  refundWindowDays Int      @default(7)
  manualApproval   Boolean  @default(true)
  updatedAt        DateTime @updatedAt
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id        BigInt   @id @default(autoincrement())
  name      String
  price     Decimal  @default(0) @db.Decimal(10, 2)
  cycle     String   @default("Monthly") // "Monthly" | "Yearly"
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubscriptionSettings {
  id                  Int      @id @default(1) // singleton row, always id = 1
  trialEnabled        Boolean  @default(true)
  trialDays           Int      @default(14)
  requireCardForTrial Boolean  @default(false)
  taxRate             Decimal  @default(13) @db.Decimal(5, 2)
  invoicePrefix       String   @default("INV-")
  autoGenerateInvoice Boolean  @default(true)
  gracePeriodDays     Int      @default(5)
  sendReminders       Boolean  @default(true)
  autoSuspend         Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model SecuritySettings {
  id Int @id @default(1) // singleton row, always id = 1

  // Password Policy
  minLength          Int     @default(8)
  requireUppercase   Boolean @default(true)
  requireNumber      Boolean @default(true)
  requireSpecialChar Boolean @default(false)

  // Two-Factor Authentication
  enforce2FA  Boolean @default(true)
  twoFAMethod String  @default("Authenticator App")

  // Session & Login Limits
  sessionTimeoutMinutes Int @default(30)
  maxLoginAttempts      Int @default(5)
  autoBlockMinutes      Int @default(15)

  // Audit Log Retention
  auditRetentionPeriod String @default("180 days")

  updatedAt DateTime @updatedAt
}
model Role {
  id          BigInt         @id @default(autoincrement())
  name        String         @unique
  description String?
  permissions Json           // { "Businesses": {"View":true,"Create":true,...}, ... }
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  admins      PlatformUser[]
}

model NotificationTemplate {
  id          BigInt   @id @default(autoincrement())
  templateKey String   @unique // "welcome" | "order" | "reset" | "suspend"
  name        String
  description String
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model NotificationSettings {
  id Int @id @default(1) // singleton row, always id = 1

  smsEnabled     Boolean @default(true)
  smsProvider    String  @default("Sparrow SMS")
  smsSenderId    String  @default("BISTROCTRL")
  smsApiKeyEnc   String?

  pushEnabled Boolean @default(true)

  errorSpikeThreshold    Int     @default(50)
  refundRateThreshold    Int     @default(10)
  failedPaymentThreshold Int     @default(15)
  alertViaEmail          Boolean @default(true)
  alertViaSms            Boolean @default(false)
  alertViaPush           Boolean @default(true)

  digestFrequency String @default("Immediate") // "Immediate" | "Hourly Digest" | "Daily Digest"

  updatedAt DateTime @updatedAt
}




model SupportMessage {
  id         BigInt   @id @default(autoincrement())
  name       String
  email      String
  message    String
  status     String   @default("unread") // "unread" | "read" | "resolved"
  createdAt  DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model BusinessReview {
  id         BigInt   @id @default(autoincrement())
  businessId BigInt
  name       String
  rating     Int      // 1–5
  comment    String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model SentNotification {
  id          BigInt   @id @default(autoincrement())
  templateKey String // "welcome" | "order" | "reset" | "suspend"
  recipient   String // email address or phone number
  subject     String
  status      String   @default("Sent") // "Sent" | "Skipped" | "Failed"
  reason      String? // why it was skipped/failed, if applicable
  createdAt   DateTime @default(now())

  @@index([templateKey])
  @@index([createdAt])
}

model BusinessNotificationPreference {
  businessId   BigInt   @id
  emailChannel Boolean  @default(true)
  smsChannel   Boolean  @default(false)
  pushChannel  Boolean  @default(true)

  newOrders       Boolean @default(true)
  orderUpdates    Boolean @default(true)
  customerReviews Boolean @default(true)
  staffActivity   Boolean @default(true)
  promotions      Boolean @default(false)
  systemAlerts    Boolean @default(true)

  quietHoursEnabled Boolean @default(false)
  quietHoursStart   String  @default("22:00")
  quietHoursEnd     String  @default("07:00")

  contactEmail String?
  contactPhone String?

  updatedAt DateTime @updatedAt
  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessNotification {
  id         BigInt   @id @default(autoincrement())
  businessId BigInt
  title      String
  message    String
  type       String   // "new_order" | "order_update" | "payment" | "review" | "staff" | "system"
  target     String   @default("all") // "admin" | "staff" | "all"
  orderId    BigInt?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([target])
  @@index([isRead])
  @@index([createdAt])
}

model SuperAdminNotification {
  id        BigInt   @id @default(autoincrement())
  title     String
  message   String
  type      String   // "business_added" | "business_suspended" | "business_deleted" | "support_report" | "system_alert"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}
