// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id              BigInt   @id @default(autoincrement())
  businessName    String
  businessType    String?
  businessAddress String?
  businessPhone   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  staff      Staff[]
  menuItems  MenuItem[]
  specials   Special[]
  locations  Location[]
  orders     Order[]
}

model Staff {
  id              BigInt   @id @default(autoincrement())
  businessId      BigInt
  fullName        String
  email           String   @unique
  password        String
  role            String   @default("staff") // "owner" | "manager" | "staff" — PERMISSION level
  position        String   @default("Waiter") // job title, e.g. "Chef", "Host" — DISPLAY only
  isActive        Boolean  @default(true)
  needsOnboarding Boolean  @default(true)
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model SuperAdmin {
  id        BigInt   @id @default(autoincrement())
  fullName  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model MenuItem {
  id          BigInt   @id @default(autoincrement())
  businessId  BigInt
  name        String
  description String?
  category    String
  price       Decimal  @db.Decimal(10, 2)
  calories    Int?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  specials   Special[]
  orderItems OrderItem[]

  @@index([businessId])
}

model Special {
  id           BigInt    @id @default(autoincrement())
  businessId   BigInt
  menuItemId   BigInt
  badgeLabel   String
  scheduleType String // "recurring" | "one-time"
  weekday      Int? // 0=Sunday..6=Saturday, used when scheduleType = "recurring"
  date         DateTime? // used when scheduleType = "one-time"
  imageUrl     String? // optional override photo; falls back to the dish's own photo
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([menuItemId])
}

// Add these three models, plus the relation lines noted at the bottom for
// Users and MenuItem.

model Customer {
  id        BigInt   @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  createdAt DateTime @default(now())

  orders Order[]

  @@unique([phone]) // one Customer row per phone number, reused across visits
}

model Location {
  id         BigInt   @id @default(autoincrement())
  businessId BigInt
  label      String // e.g. "Table 4", "Pickup Counter"
  type       String   @default("dine-in") // "dine-in" | "pickup" | "delivery"
  status     String   @default("active")
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@unique([businessId, label])
  @@index([businessId])
}

model Order {
  id            BigInt   @id @default(autoincrement())
  businessId    BigInt
  customerId    BigInt
  locationId    BigInt?
  orderType     String // "dine-in" | "pickup" | "delivery"
  status        String   @default("new") // "new" | "preparing" | "ready" | "completed" | "delayed"
  delayReason   String?
  paymentStatus String   @default("unpaid") // "unpaid" | "paid"
  totalAmount   Decimal  @db.Decimal(10, 2)
  orderedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id])
  location Location?   @relation(fields: [locationId], references: [id])
  items    OrderItem[]

  @@index([businessId])
  @@index([status])
}

model OrderItem {
  id         BigInt   @id @default(autoincrement())
  orderId    BigInt
  menuItemId BigInt
  name       String // snapshot of the dish name at order time
  unitPrice  Decimal  @db.Decimal(10, 2) // snapshot of price at order time
  quantity   Int
  notes      String? // e.g. "No Parsley"
  createdAt  DateTime @default(now())

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
}

model PlatformUser {
  id           BigInt    @id @default(autoincrement())
  fullName     String
  email        String    @unique
  phone        String?
  role         String    @default("Viewer") // "Super Admin" | "Admin" | "Moderator" | "Support" | "Viewer"
  department   String?
  status       String    @default("Active") // "Active" | "Suspended"
  permissions  String[]  @default([])
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  activities PlatformUserActivity[]
}

model PlatformUserActivity {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  label     String
  createdAt DateTime @default(now())

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SystemLog {
  id              BigInt   @id @default(autoincrement())
  event           String
  module          String // "Authentication" | "Businesses" | "Payments" | "Global Config" | "System" ...
  level           String   @default("Info") // "Info" | "Warning" | "Critical"
  status          String // "Success" | "Completed" | "Failed" | "Blocked"
  userName        String?
  userInitials    String?
  business        String?
  ipAddress       String?
  details         String? // extra text shown in the View modal
  isSecurityEvent Boolean  @default(false)
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([level])
  @@index([module])
  @@index([createdAt])
  @@index([archived])
}

// Add to schema.prisma

model BusinessRule {
  id                    BigInt  @id @default(autoincrement())
  // there is only ever ONE row here — treated as a singleton settings record
  autoApproveBusinesses Boolean @default(false)
  requireVerification   Boolean @default(true)
  defaultBusinessStatus String  @default("Pending") // "Pending" | "Active" | "Suspended"

  payoutFrequency String  @default("Weekly") // "Daily" | "Weekly" | "Bi-Weekly" | "Monthly"
  payoutThreshold Decimal @default(1000) @db.Decimal(10, 2)
  payoutMethod    String  @default("Bank Transfer") // "Bank Transfer" | "eSewa" | "Khalti"

  minOrderValue            Decimal @default(150) @db.Decimal(10, 2)
  allowPerBusinessOverride Boolean @default(true)

  updatedAt DateTime @updatedAt

  documents RequiredDocument[]
  tiers     CommissionTier[]
}

model RequiredDocument {
  id        BigInt  @id @default(autoincrement())
  ruleId    BigInt
  name      String
  required  Boolean @default(false)
  sortOrder Int     @default(0)

  rule BusinessRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

model CommissionTier {
  id         BigInt  @id @default(autoincrement())
  ruleId     BigInt
  name       String
  commission Decimal @db.Decimal(5, 2) // percentage, e.g. 12.00
  sortOrder  Int     @default(0)

  rule BusinessRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}
