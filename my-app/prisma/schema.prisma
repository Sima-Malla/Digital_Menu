// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id              BigInt   @id @default(autoincrement())
  businessName    String
  businessType    String?
  businessAddress String?
  businessPhone   String?
  needsOnboarding Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  staff      Staff[]
  menuItems  MenuItem[]
  specials   Special[]
  locations  Location[]
  orders     Order[]
}

// Add these two fields to your existing Staff model:

model Staff {
  id         BigInt   @id @default(autoincrement())
  businessId BigInt
  fullName   String
  email      String   @unique
  password   String
  role       String   @default("staff") // "owner" | "manager" | "staff" — PERMISSION level
  position   String   @default("Waiter") // <-- new: job title, e.g. "Chef", "Host" — DISPLAY only
  isActive   Boolean  @default(true)      // <-- new
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}


model SuperAdmin {
  id        BigInt   @id @default(autoincrement())
  fullName  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model MenuItem {
  id          BigInt   @id @default(autoincrement())
  businessId  BigInt
  name        String
  description String?
  category    String
  price       Decimal  @db.Decimal(10, 2)
  calories    Int?
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
 
 business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  specials    Special[]
   orderItems OrderItem[]
 
  @@index([businessId])
}

model Special {
  id           BigInt    @id @default(autoincrement())
  businessId   BigInt
  menuItemId   BigInt
  badgeLabel   String
  scheduleType String // "recurring" | "one-time"
  weekday      Int? // 0=Sunday..6=Saturday, used when scheduleType = "recurring"
  date         DateTime? // used when scheduleType = "one-time"
  imageUrl     String? // optional override photo; falls back to the dish's own photo
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
 
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menuItem     MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
 
  @@index([businessId])
  @@index([menuItemId])
}

// Add these three models, plus the relation lines noted at the bottom for
// Users and MenuItem.

model Customer {
  id        BigInt   @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  createdAt DateTime @default(now())

  orders Order[]

  @@unique([phone]) // one Customer row per phone number, reused across visits
}

model Location {
  id         BigInt   @id @default(autoincrement())
  businessId BigInt
  label      String // e.g. "Table 4", "Pickup Counter"
  type       String   @default("dine-in") // "dine-in" | "pickup" | "delivery"
  status     String   @default("active")
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([businessId, label])
  @@index([businessId])
}

model Order {
  id            BigInt   @id @default(autoincrement())
  businessId    BigInt
  customerId    BigInt
  locationId    BigInt?
  orderType     String // "dine-in" | "pickup" | "delivery"
  status        String   @default("new") // "new" | "preparing" | "ready" | "completed" | "delayed"
  delayReason   String?
  paymentStatus String   @default("unpaid") // "unpaid" | "paid"
  totalAmount   Decimal  @db.Decimal(10, 2)
  orderedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer    @relation(fields: [customerId], references: [id])
  location      Location?   @relation(fields: [locationId], references: [id])
  items         OrderItem[]

  @@index([businessId])
  @@index([status])
}

model OrderItem {
  id         BigInt   @id @default(autoincrement())
  orderId    BigInt
  menuItemId BigInt
  name       String // snapshot of the dish name at order time
  unitPrice  Decimal  @db.Decimal(10, 2) // snapshot of price at order time
  quantity   Int
  notes      String? // e.g. "No Parsley"
  createdAt  DateTime @default(now())

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
}

